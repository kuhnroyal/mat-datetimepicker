{
  "name": "mat-datetimepicker",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "npm run build:lib && ng build",
    "build:prod": "npm run build:lib && ng build --configuration production --stats-json",
    "build:lib": "npm run build:lib/core && npm run build:lib/moment && copy-files-from-to --config copy-files.json",
    "build:lib/core": "ng build core --configuration production",
    "build:lib/moment": "ng build moment --configuration production",
    "build:pages": "ng build --base-href=/mat-datetimepicker/ --configuration production",
    "bundle-report": "webpack-bundle-analyzer dist/app/stats.json",
    "lint": "ng lint",
    "publish:pages": "ng deploy",
    "prepare": "husky",
    "prettier": "prettier \"{,e2e/**/,projects/**/,src/**/}*.{md,java,json,y(a)?ml,html,js,ts,tsx,css,scss}\"",
    "prettier:check": "npm run prettier -- --check",
    "prettier:fix": "npm run prettier -- --write",
    "start": "ng serve",
    "start:prod": "ng serve --configuration production",
    "test": "ng test",
    "test:watch": "ng test --auto-watch --no-single-run",
    "watch:lib/core": "ng build core --watch",
    "watch:lib/moment": "ng build moment --watch"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "19.2.1",
    "@angular/cdk": "19.2.2",
    "@angular/common": "19.2.1",
    "@angular/compiler": "19.2.1",
    "@angular/core": "19.2.1",
    "@angular/forms": "19.2.1",
    "@angular/material": "19.2.2",
    "@angular/material-moment-adapter": "19.2.2",
    "@angular/platform-browser": "19.2.1",
    "@angular/platform-browser-dynamic": "19.2.1",
    "@angular/router": "19.2.4",
    "copy-files-from-to": "3.12.1",
    "mat-datetimepicker": "file:",
    "moment": "2.30.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "19.2.1",
    "@angular/cli": "19.2.1",
    "@angular/compiler-cli": "19.2.1",
    "@angular/language-service": "19.2.1",
    "@commitlint/cli": "19.7.1",
    "@commitlint/config-conventional": "19.7.1",
    "@eslint/eslintrc": "3.3.0",
    "@eslint/js": "9.23.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "11.0.1",
    "@semantic-release/npm": "12.0.1",
    "@semantic-release/release-notes-generator": "14.0.3",
    "@types/jasmine": "5.1.7",
    "@types/jasminewd2": "2.0.13",
    "@types/node": "22.13.9",
    "angular-cli-ghpages": "2.0.3",
    "angular-eslint": "19.2.0",
    "eslint": "9.21.0",
    "eslint-config-prettier": "10.0.2",
    "eslint-plugin-prettier": "5.2.3",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "globals": "16.0.0",
    "husky": "9.1.7",
    "jasmine-core": "5.6.0",
    "jasmine-spec-reporter": "7.0.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage-istanbul-reporter": "3.0.3",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "lint-staged": "15.4.3",
    "ng-packagr": "19.2.0",
    "prettier": "3.5.3",
    "semantic-release": "24.2.3",
    "ts-node": "10.9.2",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.0",
    "webpack-bundle-analyzer": "4.10.2"
  },
  "optionalDependencies": {
    "npm-check-updates": "17.1.16"
  },
  "engines": {
    "node": "^20.18.2 || ^22.13.1"
  }
}
