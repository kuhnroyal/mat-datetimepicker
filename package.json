{
  "name": "mat-datetimepicker",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "npm run build:lib && ng build",
    "build:prod": "npm run build:lib && ng build --configuration production --stats-json",
    "build:lib": "npm run build:lib/core && npm run build:lib/moment && copy-files-from-to --config copy-files.json",
    "build:lib/core": "ng build core --configuration production",
    "build:lib/moment": "ng build moment --configuration production",
    "build:pages": "ng build --configuration production",
    "bundle-report": "webpack-bundle-analyzer dist/app/stats.json",
    "lint": "ng lint",
    "publish:pages": "ng deploy --base-href=/mat-datetimepicker/",
    "prepare": "husky",
    "prettier": "prettier \"{,e2e/**/,projects/**/,src/**/}*.{md,java,json,y(a)?ml,html,js,ts,tsx,css,scss}\"",
    "prettier:check": "npm run prettier -- --check",
    "prettier:fix": "npm run prettier -- --write",
    "start": "ng serve",
    "start:prod": "ng serve --configuration production",
    "test": "ng test --no-watch",
    "test:watch": "ng test",
    "watch:lib/core": "ng build core --watch",
    "watch:lib/moment": "ng build moment --watch"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.1.2",
    "@angular/cdk": "21.1.2",
    "@angular/common": "21.1.2",
    "@angular/compiler": "21.1.2",
    "@angular/core": "21.1.2",
    "@angular/forms": "21.1.2",
    "@angular/material": "21.1.2",
    "@angular/material-moment-adapter": "21.1.2",
    "@angular/platform-browser": "21.1.2",
    "@angular/platform-browser-dynamic": "21.1.2",
    "@angular/router": "21.1.2",
    "copy-files-from-to": "4.0.0",
    "mat-datetimepicker": "file:",
    "moment": "2.30.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.0"
  },
  "devDependencies": {
    "@angular/build": "21.1.2",
    "@angular/cli": "21.1.2",
    "@angular/compiler-cli": "21.1.2",
    "@angular/language-service": "21.1.2",
    "@commitlint/cli": "20.4.0",
    "@commitlint/config-conventional": "20.4.0",
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.2",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.3",
    "@semantic-release/npm": "13.1.3",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@types/jasmine": "6.0.0",
    "@types/jasminewd2": "2.0.13",
    "@types/node": "25.1.0",
    "angular-cli-ghpages": "3.0.2",
    "angular-eslint": "21.2.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "globals": "17.3.0",
    "husky": "9.1.7",
    "jasmine-core": "6.0.1",
    "jasmine-spec-reporter": "7.0.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage-istanbul-reporter": "3.0.3",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.2.0",
    "lint-staged": "16.2.7",
    "ng-packagr": "21.1.0",
    "prettier": "3.8.1",
    "semantic-release": "25.0.3",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "webpack-bundle-analyzer": "5.2.0"
  },
  "optionalDependencies": {
    "npm-check-updates": "19.3.2"
  },
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0 <23 || >=24.0.0 <25"
  }
}
