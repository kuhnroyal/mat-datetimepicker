{
  "name": "mat-datetimepicker",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "npm run build:lib && ng build",
    "build:prod": "npm run build:lib && ng build --configuration production --stats-json",
    "build:lib": "npm run build:lib/core && npm run build:lib/moment && copy-files-from-to --config copy-files.json",
    "build:lib/core": "ng build core --configuration production",
    "build:lib/moment": "ng build moment --configuration production",
    "build:pages": "ng build --configuration production",
    "bundle-report": "webpack-bundle-analyzer dist/app/stats.json",
    "lint": "ng lint",
    "publish:pages": "ng deploy --base-href=/mat-datetimepicker/",
    "prepare": "husky",
    "prettier": "prettier \"{,e2e/**/,projects/**/,src/**/}*.{md,java,json,y(a)?ml,html,js,ts,tsx,css,scss}\"",
    "prettier:check": "npm run prettier -- --check",
    "prettier:fix": "npm run prettier -- --write",
    "start": "ng serve",
    "start:prod": "ng serve --configuration production",
    "test": "ng test --no-watch",
    "test:watch": "ng test",
    "watch:lib/core": "ng build core --watch",
    "watch:lib/moment": "ng build moment --watch"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.0.2",
    "@angular/cdk": "22.0.2",
    "@angular/common": "22.0.2",
    "@angular/compiler": "22.0.2",
    "@angular/core": "22.1.0",
    "@angular/forms": "22.0.2",
    "@angular/material": "22.0.2",
    "@angular/material-moment-adapter": "22.0.2",
    "@angular/platform-browser": "22.0.2",
    "@angular/platform-browser-dynamic": "22.0.2",
    "@angular/router": "22.0.2",
    "copy-files-from-to": "4.0.1",
    "mat-datetimepicker": "file:",
    "moment": "2.30.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.0.2",
    "@angular/cli": "22.0.2",
    "@angular/compiler-cli": "^22.0.2",
    "@angular/language-service": "22.0.2",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.8",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "25.9.3",
    "angular-cli-ghpages": "3.1.0",
    "angular-eslint": "22.0.0",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^29.1.1",
    "lint-staged": "17.0.7",
    "ng-packagr": "22.0.0",
    "prettier": "3.8.4",
    "semantic-release": "25.0.5",
    "ts-node": "10.9.2",
    "typescript": ">=6.0 <6.1",
    "typescript-eslint": "8.61.1",
    "vite": "^8.0.16",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9",
    "webpack-bundle-analyzer": "5.3.0"
  },
  "optionalDependencies": {
    "npm-check-updates": "22.2.3"
  },
  "engines": {
    "node": "^24.15.0 || ^26.0.0"
  }
}
